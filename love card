```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For You ♡</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    overflow: hidden;
    font-family: Georgia, "Times New Roman", serif;
    background:
        radial-gradient(circle at top, #30243f, #120e1d 55%, #07060c);
    color: #fff;
}

/* Stars */

.star {
    position: absolute;
    width: 3px;
    height: 3px;
    background: white;
    border-radius: 50%;
    box-shadow: 0 0 10px white;
    animation: sparkle 3s infinite ease-in-out;
}

/* Main card */

.card {
    position: relative;
    z-index: 10;

    width: min(90%, 600px);
    max-height: 90vh;
    overflow-y: auto;

    padding: 45px 35px;
    text-align: center;

    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 30px;

    backdrop-filter: blur(15px);
    box-shadow: 0 25px 80px rgba(0,0,0,.45);

    animation: appear 1.5s ease;
}

.small {
    font-size: 11px;
    letter-spacing: 5px;
    opacity: .6;
    text-transform: uppercase;
}

h1 {
    font-size: clamp(42px, 9vw, 70px);
    font-weight: normal;
    margin: 18px 0;
}

.subtitle {
    font-size: 18px;
    line-height: 1.8;
    opacity: .8;
}

/* Button */

button {
    margin-top: 25px;
    padding: 14px 30px;

    border: 1px solid rgba(255,255,255,.35);
    border-radius: 30px;

    background: rgba(255,255,255,.1);
    color: white;

    font-family: Georgia, serif;
    font-size: 15px;

    cursor: pointer;
    transition: .4s;
}

button:hover {
    background: rgba(255,255,255,.22);
    transform: translateY(-3px);
}

/* Letter */

.letter {
    display: none;
    margin-top: 30px;
    animation: letterAppear 1.2s ease;
}

.letter p {
    font-size: 18px;
    line-height: 1.9;
    margin: 20px 0;
}

.divider {
    width: 60px;
    height: 1px;
    background: rgba(255,255,255,.5);
    margin: 25px auto;
}

.big-love {
    font-size: 27px !important;
    font-style: italic;
}

/* Secret */

.secret {
    display: none;
    margin-top: 25px;
    font-size: 16px;
    line-height: 1.8;
    opacity: .8;
}

/* Floating hearts */

.heart {
    position: absolute;
    bottom: -30px;
    z-index: 3;

    color: rgba(255,255,255,.8);
    font-size: 20px;

    animation: floatUp 7s linear forwards;
}

/* Animations */

@keyframes sparkle {
    0%,100% {
        opacity: .15;
        transform: scale(.7);
    }

    50% {
        opacity: 1;
        transform: scale(1.5);
    }
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes letterAppear {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes floatUp {
    0% {
        transform: translateY(0);
        opacity: 0;
    }

    15% {
        opacity: .8;
    }

    100% {
        transform: translateY(-110vh);
        opacity: 0;
    }
}
</style>
</head>


<body>

<div class="card">

    <div class="small">
        A little something for you
    </div>

    <h1>Hey, You ♡</h1>

    <div class="subtitle">
        I could have simply said "I like you..."<br>
        but honestly, that wouldn't even come close.
    </div>

    <button onclick="openLetter()">
        Open my heart ♡
    </button>


    <div class="letter" id="letter">

        <div class="divider"></div>

        <p>
            You have somehow become one of my favorite thoughts.
        </p>

        <p>
            I think about you at the most random moments,
            and somehow you always manage to make me smile
            without even being here.
        </p>

        <p>
            There's something about you that I can't quite explain.
            Your smile, your voice, your little habits...
            somehow my brain decided that remembering
            every tiny detail about you is extremely important.
        </p>

        <p>
            I swear, sometimes I just sit there thinking about you
            and wondering how one person managed to become
            this adorable, this fascinating,
            and this impossible to ignore.
        </p>

        <p>
            You're dangerously easy to admire.
            And unfortunately for me...
            I don't think I'm trying very hard to stop.
        </p>

        <div class="divider"></div>

        <p class="big-love">
            If liking you is a little ridiculous,
            then I happily accept being ridiculous. ♡
        </p>

        <button onclick="showSecret()">
            One more secret...
        </button>

        <div class="secret" id="secret">

            <div class="divider"></div>

            <p>
                The truth is...
            </p>

            <p>
                I don't just want to talk to you.
                I want to know your favorite songs,
                your weird little thoughts,
                the things that make you laugh,
                the dreams you don't tell everyone about,
                and all those tiny pieces of you
                that make you uniquely you.
            </p>

            <p class="big-love">
                So yes... you're kind of a big deal to me. ♡
            </p>

        </div>

    </div>

</div>


<script>

/* Create stars */

for (let i = 0; i < 140; i++) {

    const star = document.createElement("div");

    star.className = "star";

    star.style.left =
        Math.random() * 100 + "vw";

    star.style.top =
        Math.random() * 100 + "vh";

    star.style.animationDelay =
        Math.random() * 3 + "s";

    document.body.appendChild(star);
}


/* Open letter */

function openLetter() {

    const letter =
        document.getElementById("letter");

    letter.style.display = "block";

    createHeartBurst();
}


/* Secret message */

function showSecret() {

    const secret =
        document.getElementById("secret");

    secret.style.display = "block";

    createHeartBurst();
}


/* Floating hearts */

function createHeart() {

    const heart =
        document.createElement("div");

    heart.className = "heart";

    heart.innerHTML =
        Math.random() > .5 ? "♡" : "♥";

    heart.style.left =
        Math.random() * 100 + "vw";

    heart.style.animationDuration =
        (5 + Math.random() * 5) + "s";

    heart.style.fontSize =
        (12 + Math.random() * 20) + "px";

    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 10000);
}

setInterval(createHeart, 800);


/* Heart burst */

function createHeartBurst() {

    for (let i = 0; i < 25; i++) {

        const heart =
            document.createElement("div");

        heart.className = "heart";

        heart.innerHTML = "♡";

        heart.style.left =
            (40 + Math.random() * 20) + "vw";

        heart.style.bottom =
            (35 + Math.random() * 20) + "vh";

        heart.style.animationDuration =
            (2 + Math.random() * 3) + "s";

        document.body.appendChild(heart);

        setTimeout(() => {
            heart.remove();
        }, 6000);
    }
}

</script>

</body>
</html>
```
